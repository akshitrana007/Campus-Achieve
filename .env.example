# Copy to backend/.env and replace every placeholder.
NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# College email authentication
COLLEGE_EMAIL_DOMAIN=college.example.edu
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=campus_achieve
DB_USER=campus_app
DB_PASSWORD=replace-me
DB_SSL=false

# Initial admin setup: create-admin reads these only to create the first admin.
INITIAL_ADMIN_EMAIL=teacher@college.example.edu
INITIAL_ADMIN_NAME=College Administrator
# Set a strong temporary password before running create-admin.
INITIAL_ADMIN_PASSWORD=replace-me-now

# S3-compatible private storage (Cloudflare R2 example)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=campus-achieve-private
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PUBLIC_BASE_URL=
# Signed URL expiry in seconds (short-lived links)
SIGNED_URL_TTL_SECONDS=120
MAX_FILE_SIZE_MB=10

# Optional roster enforcement. Keep true for production and import official roster first.
ENFORCE_ROSTER=true
